# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hệ thống Quản lý" <your-email@gmail.com>
SMTP_SANDBOX_EMAIL=

# Twilio Configuration for sending real SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=

# Gemini Configuration for AI Chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Webhook Secret for Bank Integrations (Casso/SePay)
WEBHOOK_SECRET=
